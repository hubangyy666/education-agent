# 首次用公网 IP 测试时，两项均填写 http://你的公网IP。
# 绑定已解析域名后，SITE_ADDRESS 和 PUBLIC_ORIGIN 均改为 https://你的域名，
# 同时将 COOKIE_SECURE 改为 true。
SITE_ADDRESS=http://203.0.113.10
PUBLIC_ORIGIN=http://203.0.113.10
COOKIE_SECURE=false

# 必须替换为互不相同的长随机值，禁止提交真实值。
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ACCESS_KEY=zhiji-production
MINIO_PASSWORD=replace-with-another-long-random-password

# 首次创建数据库时使用。管理员密码和体验账号密码必须不同，且不要沿用 123456。
DEMO_ACCOUNTS_ENABLED=true
BOOTSTRAP_STUDENT_PASSWORD=replace-with-a-strong-demo-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-strong-admin-password

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERAL_MODEL=deepseek-v4-pro
QUESTION_MODEL=deepseek-v4-flash-vision-exp
EMBEDDING_BACKEND=hash
BGE_ENDPOINT=
BGE_RERANK_ENDPOINT=
